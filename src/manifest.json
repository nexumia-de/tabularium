{
  "id": "tabularium",
  "name": "Git Sync",
  "version": "0.3.0",
  "manifestVersion": 1,
  "minSupVersion": "20.0.0",
  "description": "Keeps Super Productivity's local sync folder in a GitHub repository, so Day Planner on the phone shares the same data.",
  "author": "nexumia",
  "hooks": [
    "dataChanged"
  ],
  "permissions": [
    "nodeExecution",
    "http",
    "triggerSync",
    "showSnack",
    "showIndexHtmlAsView"
  ],
  "dataSharing": [
    {
      "recipient": "GitHub (your private sync repository)",
      "hosts": [
        "api.github.com"
      ],
      "data": [
        "credentials",
        "taskTitles",
        "taskNotes",
        "taskSchedule",
        "taskStatus",
        "timeTracked",
        "projectAndTagNames",
        "ids"
      ]
    }
  ],
  "iFrame": true,
  "icon": "cloud_sync",
  "allowedHosts": [
    "api.github.com"
  ]
}
